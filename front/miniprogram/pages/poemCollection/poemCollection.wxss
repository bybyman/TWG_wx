/* pages/poemCollection/poemCollection.wxss */
page{
  background-color: #F3DCDB; 
}
.main{
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.poem{
  display: flex;
  width: 700rpx;
  height: 200rpx;
  background-color: #FBEED4;
  position: relative;
  margin-bottom: 30rpx;
}
image{
  position:absolute;
  width: 700rpx;
  height: 200rpx;
}
.poem-title{
  font-size: 45rpx;
  font-weight: bold;
  margin-top: 30rpx;
  margin-left: 70rpx;
}
.poem-author{
  color: #7F7F7F;
  margin-top: 30rpx;
  margin-left: 90rpx;
}
.poem-left{
  box-sizing: border-box;
  width: 500rpx;
  /* padding-left: 50rpx; */
}

.poem-right{
  color: red;
  display: flex;
  align-items: center;
}