/* pages/AIGenerate/AIText/AIText.wxss */
page{
  background-color: #F3DAD9;
}
.imgbox image{
  width: 100rpx;
  height: 100rpx;
}
.imgbox{
  font-weight: bold;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 50rpx;
  margin-top: 30rpx;
}
.banner{
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0 10rpx;
  bottom: 0;
  margin-top: 30rpx;
}
.banner image{
  width: 730rpx;
  height: 400rpx;
}
.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: left;
  margin-top: 10rpx;
}
.content image{
  width: 50rpx;
  height: 50rpx;
  vertical-align: middle;
}
.content p{
  display: block;
}
.content span {
 margin-left: 30rpx; /* 或者你可以设置为一个具体的宽度 */
}
.input{
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
}
.input textarea{
  box-sizing: border-box;
  padding: 15rpx;
  width: 700rpx;
  background-color: #F7E7E6;
  height: 150rpx;
  border-radius: 10rpx;
}
.return{
  font-size: 30rpx;
  margin-top: 30rpx;
}
.input2{
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
}
.input2 textarea{
  box-sizing: border-box;
  padding: 15rpx;
  width: 700rpx;
  background-color: #F7E7E6;
  height: 125rpx;
  border-radius: 10rpx;
}
button{
  margin: 0;
  padding: 5rpx 10rpx;
  background-color: #F7E7E6;
  margin-top: 20rpx;

}