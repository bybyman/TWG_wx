<view class="personalContainer">

  <view class="user-section">
    <image class="bg" src="{{backgroundUrl}}"></image>
    <view class="user-info-box" bindtap="getUserInfo">
      <view class="portrait-box">
        <image class="portrait" src='{{userInfo.avatarUrl?userInfo.avatarUrl:"/images/personal/missing-face.png"}}'></image>
      </view>
      <view class="info-box">
        <text class="username">{{userInfo.nickName?userInfo.nickName: '授权登录'}}</text>
      </view>
    </view> 
  </view>

<view class="cover-container" style="transform: {{coverTransform}}; transition: {{coveTransition}}">
  <image class="arc" src="/images/personal/arc.png"></image>
  <!-- 个人中心导航 -->
  <scroll-view class="major" scroll-x>   
      <navigator class="box" url="/pages/about_intro/about_intro">
        <image class="pic" src="/images/personal/mess.png"/>
        <view class="txt">我的消息</view>
      </navigator>
      <navigator class="box" url="/pages/tabMain/tabMain" bindtap="checks">
        <image class="pic" src="/images/personal/personal.png"/>
        <view class="txt">个人信息</view>
      </navigator>
      <navigator class="box" url="/pages/about_update/about_update">
        <image class="pic" src="/images/personal/bang.png"/>
        <view class="txt">检查更新</view>
      </navigator>
</scroll-view>
<!-- 个人中心列表 -->
  <view class="personalContent">
      <view class="cardList">
        <view class="card-item" bindtap="toCenter">
          <text class="title">点评中心</text>
          <text class="more"> > </text>
        </view>
        <view class="card-item" bindtap="toMemorandum">
          <text class="title">特色功能</text>
          <text class="more"> > </text>
        </view>
      </view>
  </view>
</view>
  <view class="title1" bindtap="toLogout">
    <text>退出登录</text>
  </view>
</view>

