.personalContainer {
    width: 100%;
    height: 100%;
    font-family: 得意黑, sans-serif;
  }
  .personalContainer .user-section {
    height: 420rpx;
    position: relative;
    padding: 100rpx 30rpx 0;
  }
  .user-section .bg { 
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    opacity: 0.8;
    
  }
  .user-info-box{
    height: 180rpx;
    display:flex;
    align-items:center;
    position:relative;
    z-index: 1;
  }
  .user-info-box .portrait{
    width: 130rpx;
    height: 130rpx;
    border:5rpx solid #fff;
    border-radius: 50%;
  }
  .user-info-box .username{
    font-size: 24;
    font-weight: bold;
    color: #fd0d29;
    margin-left: 20rpx;
  }
  .cover-container .arc{
    position:absolute;
    left: 0;
    top: -34rpx;
    width: 100%;
    height: 36rpx;
  }
.major{ white-space: nowrap; padding:10rpx 10rpx;}
.major .box{ text-align: center; width:248rpx; display: inline-block; }
.major .pic{width:100rpx; height: 100rpx;}
.major .txt{ font-size:24rpx; margin-top:6rpx;} 

  /* 个人中心列表 */
  .personalContent {
    background: #fff;
    margin-top: 10rpx;
  }
  
  .cardList {
    margin-top: 10rpx;
  }
  .cardList .card-item{
    border-top: 2rpx solid #eee;
    line-height: 60rpx;
    padding: 15rpx;
    font-size: 30rpx;
    color: #333;
    margin-left: 20rpx;
    margin-right: 20rpx;
  }
  .cardList .card-item .more {
    float: right;
  }
  .title1{
    line-height: 80rpx;
    margin-left: 30rpx;
    background: #fff;
    border-top: 2rpx solid #eee;
    font-size: 30rpx;
    color: #333;
  } 