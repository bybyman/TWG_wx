  <button class="button button2" bindtap="Rl">向左90度</button>
    <button class="button button3" bindtap="Rr">向右90度</button>
</view>
<image src="{{imageUrl}}" style="width: 300px; height: 200px; position: absolute; right: 15%; top: 40%; transform: translateY(-50%);"></image>