<view>
  <MyNavigation default-data="{{defaultData}}"></MyNavigation>
  <view class="overall">
    <view class="publish-comment">
      <view class="input">
          <textarea auto-height="true" value="" placeholder="晒图分享你的旅途吧~好的评论会优先被看到哦~"/>
      </view>
      <view class="opreation">
        <!-- 上传 S -->
        <view class="img-list">
        <!-- 上传列表 -->
        <view class="upload-video">
          <block wx:if="{{src != ''}}">
            <video src="{{src}}" class="img-li"></video>
            <image class="icon-deletes" src="/images/BBS/delete.jpg" bindtap="deleteVideo"></image>
          </block>
        </view>
        <block wx:for="{{imgList}}" wx:key="index">
          <view class="img-li">
            <view class="img-li" bindtap="previewImg">
              <image class="uploading-icon" src="{{item}}"></image>
            </view>
            <image class="icon-delete" src="/images/BBS/delete.jpg" bindtap="deleteImg"></image>
          </view>
        </block>
        <!-- 上传图片/视频 S -->
        <view class="img-li" wx:if="{{imgList.length<=8}}" bindtap="actioncnt">
          <image class="uploading-icon" src="/images/BBS/add.jpg"></image>
        </view>
        <!-- 上传图片/视频 E -->
        <view class="buttonbox">
          <button> 发布评论 </button>
        </view>
        </view>
        <!-- 上传 E -->
      </view>
    </view>
    <view class="view-comment">
        <view class="comment">
          <view class="comment-title">
            <span><text decode="true">&lt;</text></span>
            <span class="comment-title-text">评价详情</span>
            <span class="icon-share"><image src="/images/BBS/share.png" mode=""/></span>
            <span class="icon-more" bindtap="goDetail"><image src="/images/BBS/more.png" mode=""/></span>
          </view>
          <view class="comment-author">
            <span class="comment-author-imagebox"><image src="/images/BBS/head.jpg" mode=""/></span>
            <span>滕王阁景区游客</span>
            <span class="comment-date">2024/4/17</span>
          </view>
          <view class="comment-content">
            <custom-content content="滕王阁，这座承载着深厚历史与文化底蕴的仿古建筑，坐落于四川省南充市阗中市境内，其独特的魅力与丰富的内涵吸引着无数游客前来探访。今天，我将为大家带来一篇关于滕王阁的点评推荐，让我们一起领略这座古建筑的独特魅力。滕王阁的历史沿革可谓悠久。唐调露元年（679年）,滕王李元婴任隆州（今四川阗中）刺史时，大修宫殿" maxline="5" position="left" foldable="true"></custom-content>
          </view>
        </view>
        <view class="comment">
          <view class="comment-title">
            <span><text decode="true">&lt;</text></span>
            <span class="comment-title-text">评价详情</span>
            <span class="icon-share"><image src="/images/BBS/share.png" mode=""/></span>
            <span class="icon-more" bindtap="goDetail"><image src="/images/BBS/more.png" mode=""/></span>
          </view>
          <view class="comment-author">
            <span class="comment-author-imagebox"><image src="/images/BBS/head.jpg" mode=""/></span>
            <span>滕王阁景区游客</span>
            <span class="comment-date">2024/4/17</span>
          </view>
          <view class="comment-content">
            <custom-content content="滕王阁，这座承载着深厚历史与文化底蕴的仿古建筑，坐落于四川省南充市阗中市境内，其独特的魅力与丰富的内涵吸引着无数游客前来探访。今天，我将为大家带来一篇关于滕王阁的点评推荐，让我们一起领略这座古建筑的独特魅力。滕王阁的历史沿革可谓悠久。唐调露元年（679年）,滕王李元婴任隆州（今四川阗中）刺史时，大修宫殿" maxline="5" position="left" foldable="true"></custom-content>
          </view>
        </view>
    </view>
  </view>
</view>