/* pages/Space-detail/Space-detail.wxss */
page{
  background-color: #F3DAD9;
}
button{
  margin: 0 !important;
  padding: 0 !important;
}
.imagebox{
  width: 100%;
  height: 350rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FEF0D8;
}
.imagebox image{
  width: 550rpx;
  height: 300rpx;
  border-radius: 30rpx;
}
.banner{
  display: flex;
  flex-direction: column;
  text-align: center;
}
.title{
  font-weight: bold;
  font-size: 40rpx;
  margin-bottom: 50rpx;
}
.location, .camera{
  display: flex;
  margin-left: 50rpx;
  margin-bottom: 50rpx;
}
.camera{
  margin-bottom: 25rpx;
}
.location image, .camera image{
  width: 50rpx;
  height: 50rpx;
  margin-right: 10rpx;
}
.content{
  display: flex;
  flex-direction: column;
  align-items: center;
}
.input{
  background-color: #fff;
  width: 700rpx;
  height: 400rpx;
  padding: 30rpx;
  box-sizing: border-box;
  text-align: left;
  border-radius: 30rpx;
  position: relative;
}
.input textarea{
  width: 650rpx;
  height: 270rpx;
}
.publish{
  /* top: 70%; */
  transform: translateY(-50%);
  padding: 0;
  margin: 0;
  background-color: #E28A8A;
  color: white;
  width: 300rpx !important;
  height: 70rpx;
  line-height: 70rpx;
  left: 50%;
  transform: translateX(-50%);
}
.foot{
  margin-top: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.foot image{
  width: 60rpx;
  height: 60rpx;
  margin-right: 20rpx;
}
.foot view{
  background-color: #F0AF8B;
  color: white;
  height: 60rpx;
  line-height: 60rpx;
  width: 400rpx;
}
